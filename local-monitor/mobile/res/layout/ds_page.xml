<?xml version="1.0" encoding="utf-8"?>
<!--
  DeepSeek 余额页（主界面第 4 个 Tab 的内容）。

  设计原则：
    · 沿用宿主 WorkBuddy 工具箱自己的深色玻璃卡（bg_liquid_glass / 反白三级文字 / 霓虹青蓝），
      保证和第 1~3 个 Tab 是同一个 App，而不是塞进来一块别人的界面；
    · 唯一刻意区分的是金额主色 —— 用 DeepSeek 蓝紫 ds_brand，一眼能看出这是另一本账；
    · 数据与 WorkBuddy 积分完全分离：这张页只读 DeepSeek 官方余额接口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dsPageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- ==================== 状态行 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dsDotStatus"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_off" />

        <TextView
            android:id="@+id/dsTvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="等待首次采样"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dsTvFresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text=""
            android:textColor="@color/text_faint"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/dsBtnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_liquid_button"
            android:src="@drawable/ic_refresh_modern"
            android:tint="@color/text_dim"
            android:padding="9dp"
            android:contentDescription="刷新 DeepSeek 余额" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="独立于 WorkBuddy 积分 · 手机直连 DeepSeek 官方余额接口"
        android:textColor="@color/text_faint"
        android:textSize="10.5sp"
        android:lineSpacingExtra="2dp" />

    <!-- ==================== 余额大卡 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_liquid_glass"
        android:elevation="5dp"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="DeepSeek 余额"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/dsTvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="—"
                android:textColor="@color/ds_brand"
                android:textSize="33sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/dsTvSplit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="1dp"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="今日消耗"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/dsTvToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="—"
                android:textColor="@color/warn"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/dsTvRunway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="1dp"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 近 7 天消耗 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_liquid_glass"
        android:elevation="3dp"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="近 7 天消耗"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/dsTvWeekTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <io.github.workbuddymonitor.ds.DsBarChartView
            android:id="@+id/dsChart7"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- ==================== 余额走势 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_liquid_glass"
        android:elevation="3dp"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="余额走势"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/dsTvTrendRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <io.github.workbuddymonitor.ds.DsSparkView
            android:id="@+id/dsSpark"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dsTvTrendLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/dsTvTrendHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 预警（动态填充） ==================== -->
    <LinearLayout
        android:id="@+id/dsBoxAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- ==================== 最近消耗 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_liquid_glass"
        android:elevation="3dp"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近消耗"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/dsTvRecentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dsBoxRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/dsTvRecentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="暂无消耗记录。余额一旦下降就会被记为一次消耗；如果余额长期不动，属于正常情况。"
            android:textColor="@color/text_faint"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 口径与隐私说明 -->
    <TextView
        android:id="@+id/dsTvFootNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text=""
        android:textColor="@color/text_faint"
        android:textSize="10.5sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />
</LinearLayout>
