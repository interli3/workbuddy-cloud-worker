<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_fresh_field" android:fitsSystemWindows="true">

    <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none" android:clipToPadding="false" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingBottom="42dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="22dp" android:paddingBottom="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvGreet" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="用量中心"
                        android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    <LinearLayout android:id="@+id/headWb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:id="@+id/dotStatus" android:layout_width="7dp" android:layout_height="7dp"
                            android:background="@drawable/dot_off" />
                        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="7dp"
                            android:text="@string/lbl_loading" android:textColor="@color/text_dim" android:textSize="12sp" />
                        <TextView android:id="@+id/tvFresh" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="5dp"
                            android:text="" android:textColor="@color/text_faint" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <ImageButton android:id="@+id/btnPrivacy" android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_liquid_button" android:src="@drawable/ic_eye_modern"
                    android:tint="@color/text_dim" android:padding="9dp" android:contentDescription="隐藏金额" />
                <ImageButton android:id="@+id/btnRefresh" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_liquid_button"
                    android:src="@drawable/ic_refresh_modern" android:tint="@color/text_dim"
                    android:padding="9dp" android:contentDescription="@string/lbl_refresh" />
                <ImageButton android:id="@+id/btnSettings" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_liquid_button"
                    android:src="@drawable/ic_settings_modern" android:tint="@color/text_dim"
                    android:padding="9dp" android:contentDescription="@string/lbl_settings" />
            </LinearLayout>

            <LinearLayout android:id="@+id/heroWb" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/bg_liquid_glass"
                android:elevation="5dp" android:padding="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="剩余可用" android:textColor="@color/text_dim" android:textSize="12sp" />
                    <TextView android:id="@+id/tvBalance" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="--"
                        android:textColor="@color/accent_deep" android:textSize="35sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvBalanceHint" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text=""
                        android:textColor="@color/text_dim" android:textSize="11.5sp" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:layout_marginStart="14dp" android:layout_marginEnd="18dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="今日消耗" android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                        <TextView android:id="@+id/tvCloudTag" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="10.5sp"
                            android:textColor="@color/accent_deep" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvUsedToday" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="--"
                        android:textColor="@color/text" android:textSize="27sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvRunway" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text=""
                        android:textColor="@color/text_dim" android:textSize="11sp" android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                android:layout_marginTop="12dp" android:orientation="horizontal"
                android:background="@drawable/bg_segment_track" android:gravity="center_vertical">
                <TextView android:id="@+id/tabOverview" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="概览" android:textSize="12.5sp" android:textStyle="bold"
                    android:textColor="@color/accent_deep" android:background="@drawable/bg_segment_active" />
                <TextView android:id="@+id/tabAccounts" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="账户" android:textSize="12.5sp" android:textStyle="bold"
                    android:textColor="@color/text_dim" android:background="@drawable/bg_segment_idle" />
                <TextView android:id="@+id/tabHistory" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="记录" android:textSize="12.5sp" android:textStyle="bold"
                    android:textColor="@color/text_dim" android:background="@drawable/bg_segment_idle" />
                <TextView android:id="@+id/tabDeepSeek" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:gravity="center"
                    android:text="DeepSeek" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/text_dim" android:background="@drawable/bg_segment_idle" />
            </LinearLayout>

            <LinearLayout android:id="@+id/pageOverview" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

            <!-- 概览页里的 DeepSeek 摘要：与上面的 WorkBuddy 余额并排可见，
                 但配色（蓝紫）与来源明确区分；点它直接进 DeepSeek 页。 -->
            <LinearLayout android:id="@+id/dsOvCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_liquid_glass" android:elevation="3dp"
                android:padding="16dp">

                <View android:id="@+id/dsOvDot" android:layout_width="7dp" android:layout_height="7dp"
                    android:background="@drawable/dot_off" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="DeepSeek 余额"
                            android:textColor="@color/text_dim" android:textSize="12sp" />
                        <TextView android:id="@+id/dsOvStatus" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:maxLines="1"
                            android:ellipsize="end" android:textColor="@color/text_faint" android:textSize="10.5sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="bottom">
                        <TextView android:id="@+id/dsOvBalance" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/ds_brand" android:textSize="24sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false" />
                        <TextView android:id="@+id/dsOvToday" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:layout_marginBottom="3dp" android:text=""
                            android:textColor="@color/warn" android:textSize="12.5sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass" android:elevation="3dp" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="近 7 天使用趋势" android:textColor="@color/text" android:textSize="15sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <io.github.workbuddymonitor.MiniChart android:id="@+id/chart7d" android:layout_width="match_parent"
                    android:layout_height="58dp" android:layout_marginTop="10dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="账户健康" android:textColor="@color/text" android:textSize="15sp"
                            android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/tvScoreWhy" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text=""
                            android:textColor="@color/text_faint" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvScore" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="28sp"
                        android:textStyle="bold" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent_deep" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvScoreWord" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text=""
                        android:textColor="@color/text_dim" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/boxHealthAccounts" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="13dp" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/boxInsightHead" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="10dp"
                android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="需要关注" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvInsightCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxInsightPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass" android:paddingStart="14dp"
                android:paddingEnd="14dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:visibility="gone">
                <LinearLayout android:id="@+id/boxInsight" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="当前任务" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvActiveCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxActive" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="扣分明细" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvFlowCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxFlow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass" android:padding="14dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/pageAccounts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="账户明细" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvAccCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxAccounts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/pageHistory" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="全部扣分" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvFlowAllCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxFlowAll" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass" android:padding="14dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="最近任务" android:textColor="@color/text" android:textSize="16sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvRecentCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="" android:textColor="@color/text_faint" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boxRecent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_liquid_glass" android:padding="14dp" />
            </LinearLayout>

            <!-- 第 4 个 Tab：DeepSeek 余额（独立于 WorkBuddy 积分，数据来自 DeepSeek 官方接口） -->
            <include layout="@layout/ds_page" />

            <TextView android:id="@+id/tvFootNote" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text=""
                android:textColor="@color/text_faint" android:textSize="10.5sp" android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
